<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>QuickAudioRecorder</AssemblyName>
    <RootNamespace>QuickAudioRecorder</RootNamespace>
    <ApplicationIcon>Resources\MiniRec_idle.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.0.0-preview.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms"/>
    <Reference Include="System.Drawing"/>
    <Reference Include="System.Runtime.Serialization"/>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\MiniRec_idle.ico" LogicalName="QuickAudioRecorder.Resources.MiniRec_idle.ico" />
    <EmbeddedResource Include="Resources\MiniRec_recording.ico" LogicalName="QuickAudioRecorder.Resources.MiniRec_recording.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.4.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
  </ItemGroup>
</Project>
