<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MiniRec</AssemblyName>
    <Title>MiniRec</Title>
    <Product>MiniRec</Product>
    <Description>Lightweight Windows tray audio recorder</Description>
    <RootNamespace>QuickAudioRecorder</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.0.0-preview.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Resources\QuickAudioRecorder.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms"/>
    <Reference Include="System.Drawing"/>
    <Reference Include="System.Runtime.Serialization"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.4.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
  </ItemGroup>
</Project>
